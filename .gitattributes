# Keep line endings sane across Windows + Linux.
* text=auto

# Files that run on Linux MUST be LF (CRLF breaks bash/systemd).
*.sh        text eol=lf
*.service   text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf

# Windows scripts stay CRLF.
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
