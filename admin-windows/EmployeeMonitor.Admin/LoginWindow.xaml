<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EmployeeMonitor.Admin.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="ms-appx:///Assets/Backgrounds/sky-login.jpg" Stretch="UniformToFill" />
        </Grid.Background>
        <Rectangle Fill="#26FFFFFF" />
        <Border MaxWidth="400" Margin="24" Padding="36"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource GlassCardBrush}"
                BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1"
                CornerRadius="18" Translation="0,0,48">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel Spacing="16">
                <StackPanel>
                    <TextBlock Text="Employee Monitor" Style="{StaticResource PageTitle}" FontSize="24" />
                    <TextBlock Text="Admin console" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBlock Text="Sign in with your administrator account"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />

                <TextBox x:Name="UsernameBox" Header="Username"
                         Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <PasswordBox x:Name="PasswordBox" Header="Password"
                             PasswordChanged="OnPasswordChanged"
                             KeyDown="OnPasswordKeyDown" />

                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" IsClosable="False"
                         Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

                <Button Content="Sign in" HorizontalAlignment="Stretch"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.LoginCommand}" />

                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              HorizontalAlignment="Center" Width="24" Height="24" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
