<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EmployeeMonitor.Admin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="ms-appx:///Assets/Backgrounds/sky-main.jpg" Stretch="UniformToFill" />
        </Grid.Background>
        <!-- Soft white scrim keeps tables and text readable over the photo. -->
        <Rectangle Fill="#66FFFFFF" />
        <muxc:NavigationView x:Name="Nav"
                             Background="Transparent"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="248"
                             SelectionChanged="OnNavSelectionChanged"
                             Loaded="OnLoaded">

            <muxc:NavigationView.PaneHeader>
                <StackPanel Margin="8,10,4,12" VerticalAlignment="Center">
                    <TextBlock Text="Employee Monitor" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Admin console" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </muxc:NavigationView.PaneHeader>

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Dashboard" Tag="dashboard" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Employees" Tag="employees">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Devices" Tag="devices">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE977;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Web access" Tag="webaccess">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Alerts" Tag="alerts">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </muxc:NavigationViewItem.Icon>
                    <muxc:NavigationViewItem.InfoBadge>
                        <muxc:InfoBadge x:Name="AlertBadge" Visibility="Collapsed"
                                        Value="{x:Bind AlertsViewModel.UnacknowledgedCount, Mode=OneWay}" />
                    </muxc:NavigationViewItem.InfoBadge>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.PaneFooter>
                <Border Margin="12,8,12,14" Padding="14,12" CornerRadius="12"
                        Background="{StaticResource GlassCardBrush}"
                        BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1"
                        Translation="0,0,24">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ShellViewModel.ConnectionStatus, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ShellViewModel.UserName, Mode=OneWay}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ShellViewModel.Roles, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Sign out" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                Command="{x:Bind ShellViewModel.LogoutCommand}" />
                    </StackPanel>
                </Border>
            </muxc:NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Window>
