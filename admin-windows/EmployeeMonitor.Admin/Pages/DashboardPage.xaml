<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EmployeeMonitor.Admin.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EmployeeMonitor.Admin.Core.ViewModels">

    <Grid Padding="28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Live workforce status" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <InfoBar Grid.Row="1" IsOpen="True" Severity="Error" IsClosable="False"
                 Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 Visibility="{x:Bind ViewModel.Error, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />

        <!-- KPI tiles -->
        <ItemsControl Grid.Row="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="14" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <Border Style="{StaticResource KpiCard}" Translation="0,0,30">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel>
                    <TextBlock Text="Total employees" Style="{StaticResource KpiLabel}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalEmployeesDisplay, Mode=OneWay}" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Translation="0,0,30">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="9" Height="9" Fill="#1F9D57" VerticalAlignment="Center" />
                        <TextBlock Text="Online" Style="{StaticResource KpiLabel}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Online, Mode=OneWay}" Style="{StaticResource KpiValue}" Foreground="#1F9D57" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Translation="0,0,30">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="9" Height="9" Fill="#C98A12" VerticalAlignment="Center" />
                        <TextBlock Text="Idle" Style="{StaticResource KpiLabel}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Idle, Mode=OneWay}" Style="{StaticResource KpiValue}" Foreground="#C98A12" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Translation="0,0,30">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="9" Height="9" Fill="#3E6FF0" VerticalAlignment="Center" />
                        <TextBlock Text="Locked" Style="{StaticResource KpiLabel}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Locked, Mode=OneWay}" Style="{StaticResource KpiValue}" Foreground="#3E6FF0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Translation="0,0,30">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="9" Height="9" Fill="#7A8599" VerticalAlignment="Center" />
                        <TextBlock Text="Offline" Style="{StaticResource KpiLabel}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Offline, Mode=OneWay}" Style="{StaticResource KpiValue}" Foreground="#7A8599" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Translation="0,0,30">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel>
                    <TextBlock Text="Active devices" Style="{StaticResource KpiLabel}" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveDevices, Mode=OneWay}" Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
        </ItemsControl>

        <!-- Live roster -->
        <Border Grid.Row="3" Style="{StaticResource GlassPanel}" Translation="0,0,36">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="18,14" ColumnSpacing="12"
                      Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="14,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Employee" Style="{StaticResource ColHeader}" />
                    <TextBlock Grid.Column="1" Text="Device" Style="{StaticResource ColHeader}" />
                    <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource ColHeader}" />
                    <TextBlock Grid.Column="3" Text="Current app / last seen" Style="{StaticResource ColHeader}" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Devices}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnDeviceClick"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="18,10" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceRowViewModel">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind EmployeeName, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Department, Mode=OneWay}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Hostname}" />
                                    <TextBlock Text="{x:Bind DeviceCode}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource StatusPill}"
                                        Background="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusToPill}}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                 Fill="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusToBrush}}" />
                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusToBrush}}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind CurrentApplication, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind LastSeenAt, Mode=OneWay}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
