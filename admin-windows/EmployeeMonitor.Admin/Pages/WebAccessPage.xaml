<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EmployeeMonitor.Admin.Pages.WebAccessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EmployeeMonitor.Admin.Core.ViewModels"
    xmlns:api="using:EmployeeMonitor.Admin.Core.Api">

    <Grid Padding="28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Web access" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Domain-level restriction and access monitoring"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Click="OnNewPolicy">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                    <TextBlock Text="New policy" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1" IsOpen="True" Severity="Error" IsClosable="False"
                 Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                 Visibility="{x:Bind ViewModel.Error, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />

        <Pivot Grid.Row="2">
            <!-- ========================= Policies ========================= -->
            <PivotItem Header="Policies">
                <Border Style="{StaticResource GlassPanel}" Translation="0,0,36">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.Policies}" SelectionMode="None"
                                  ScrollViewer.HorizontalScrollMode="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="18,12" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:WebPolicyRowViewModel">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind RuleSummary}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind AssignmentSummary}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="8" Padding="9,3"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <TextBlock Text="{x:Bind StatusLabel}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{x:Bind Priority}" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Button Content="Edit" Tag="{x:Bind}" Click="OnEditPolicy" />
                                            <Button Content="Assign" Tag="{x:Bind}" Click="OnAssignPolicy" />
                                            <Button Content="Delete" Tag="{x:Bind}" Click="OnDeletePolicy" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                    Visibility="{x:Bind ViewModel.HasPolicies, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <FontIcon Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="No web policies yet. Create one to start restricting domains."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="32" Height="32"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </PivotItem>

            <!-- ========================= Activity ========================= -->
            <PivotItem Header="Activity">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ItemsControl Grid.Row="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <Border Style="{StaticResource KpiCard}" Translation="0,0,30">
                            <Border.Shadow><ThemeShadow /></Border.Shadow>
                            <StackPanel>
                                <TextBlock Text="Observed" Style="{StaticResource KpiLabel}" />
                                <TextBlock Text="{x:Bind ViewModel.Observed, Mode=OneWay}" Style="{StaticResource KpiValue}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Translation="0,0,30">
                            <Border.Shadow><ThemeShadow /></Border.Shadow>
                            <StackPanel>
                                <TextBlock Text="Blocked" Style="{StaticResource KpiLabel}" />
                                <TextBlock Text="{x:Bind ViewModel.Blocked, Mode=OneWay}" Style="{StaticResource KpiValue}" Foreground="#C92A2A" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Translation="0,0,30">
                            <Border.Shadow><ThemeShadow /></Border.Shadow>
                            <StackPanel>
                                <TextBlock Text="Allowed" Style="{StaticResource KpiLabel}" />
                                <TextBlock Text="{x:Bind ViewModel.Allowed, Mode=OneWay}" Style="{StaticResource KpiValue}" Foreground="#1F9D57" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Translation="0,0,30">
                            <Border.Shadow><ThemeShadow /></Border.Shadow>
                            <StackPanel>
                                <TextBlock Text="Monitored" Style="{StaticResource KpiLabel}" />
                                <TextBlock Text="{x:Bind ViewModel.Monitored, Mode=OneWay}" Style="{StaticResource KpiValue}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCard}" Translation="0,0,30">
                            <Border.Shadow><ThemeShadow /></Border.Shadow>
                            <StackPanel>
                                <TextBlock Text="Enforcement errors" Style="{StaticResource KpiLabel}" />
                                <TextBlock Text="{x:Bind ViewModel.EnforcementErrors, Mode=OneWay}" Style="{StaticResource KpiValue}" Foreground="#C98A12" />
                            </StackPanel>
                        </Border>
                    </ItemsControl>

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.4*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Recent access events -->
                        <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Translation="0,0,36">
                            <Border.Shadow><ThemeShadow /></Border.Shadow>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Recent activity" Margin="18,14,18,0"
                                           Style="{StaticResource ColHeader}" />
                                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Events}" SelectionMode="None"
                                          ScrollViewer.HorizontalScrollMode="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="18,10" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WebEventRowViewModel">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" VerticalAlignment="Center" CornerRadius="8" Padding="9,3"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                    <TextBlock Text="{x:Bind ResultLabel}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{x:Bind ResultLabel, Converter={StaticResource WebResultToBrush}}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Domain}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Subject}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Text="{x:Bind OccurredAt}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                            Visibility="{x:Bind ViewModel.HasEvents, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                    <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No web activity in the selected period."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Top blocked domains -->
                        <Border Grid.Column="1" Style="{StaticResource GlassPanel}" Translation="0,0,36">
                            <Border.Shadow><ThemeShadow /></Border.Shadow>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Top blocked domains" Margin="18,14,18,8"
                                           Style="{StaticResource ColHeader}" />
                                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.TopBlocked}" SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="18,8" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="api:DomainCountDto">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Domain}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Count}" FontWeight="SemiBold"
                                                           Foreground="#C92A2A" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
