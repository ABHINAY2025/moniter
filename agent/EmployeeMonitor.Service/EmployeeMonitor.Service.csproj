<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- WinExe = no console window. The agent runs silently in the background (logon task / service);
         logs go to %ProgramData%\EmployeeMonitor\logs instead of a terminal. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>EmployeeMonitor.Service</RootNamespace>
    <AssemblyName>EmployeeMonitorAgent</AssemblyName>
    <UserSecretsId>employee-monitor-agent</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmployeeMonitor.Agent\EmployeeMonitor.Agent.csproj" />
    <ProjectReference Include="..\EmployeeMonitor.Sessions\EmployeeMonitor.Sessions.csproj" />
  </ItemGroup>

</Project>
