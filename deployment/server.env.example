# ============================================================================
#  Production server environment for the Employee Monitor backend.
#  Copy to deployment/server.env (git-ignored) and fill in real values.
#  Every value here is supplied by the operator — nothing is hardcoded in code.
# ============================================================================

# ---- Database (PostgreSQL on the server; must NOT be publicly exposed) ----
# Create the database first (see deployment/README.md), then point here.
DB_URL=jdbc:postgresql://localhost:5432/quantumdataleap?options=-c%20TimeZone=Asia/Kolkata
DB_USERNAME=postgres
DB_PASSWORD=__SET_ON_SERVER__
DB_POOL_SIZE=20

# ---- Redis (presence + pub/sub) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=__SET_ON_SERVER__

# ---- Auth / JWT (>= 32 bytes; generate: openssl rand -base64 48) ----
JWT_SECRET=__SET_ON_SERVER__
JWT_ISSUER=employee-monitor

# ---- First-run bootstrap admin (used only when the users table is empty; >=12 chars) ----
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=it-admin@quantumdataleap.ai
BOOTSTRAP_ADMIN_PASSWORD=__SET_ON_SERVER__

# ---- HTTPS / reverse proxy (behind nginx terminating TLS) ----
SERVER_PORT=8090
REQUIRE_HTTPS=true
FORWARD_HEADERS_STRATEGY=framework
CORS_ALLOWED_ORIGINS=https://admin.quantumdataleap.ai

# ---- Storage dirs (persist these; back them up) ----
SCREENSHOT_DIR=/var/lib/employee-monitor/screenshots
UPDATE_DIR=/var/lib/employee-monitor/updates
# base64, 32 bytes: openssl rand -base64 32
SCREENSHOT_ENCRYPTION_KEY=__SET_ON_SERVER__
