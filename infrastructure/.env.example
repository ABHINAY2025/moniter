# Copy to infrastructure/.env and replace every value. Never commit .env.
# Generate secrets in PowerShell with:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# or with Git Bash / WSL:
#   openssl rand -base64 48

DB_PASSWORD=change-me-db-password
REDIS_PASSWORD=change-me-redis-password
MINIO_ROOT_USER=employee-monitor
MINIO_ROOT_PASSWORD=change-me-minio-password

# At least 32 bytes.
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes

# Used once, when the database has no users, to create the first SUPER_ADMIN (min 12 chars).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=it-admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# Production behind nginx/TLS: REQUIRE_HTTPS=true and FORWARD_HEADERS_STRATEGY=framework
REQUIRE_HTTPS=false
FORWARD_HEADERS_STRATEGY=none
CORS_ALLOWED_ORIGINS=

# Host ports for the datastores (change if PostgreSQL/Redis already run natively on this PC).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Screenshot encryption key (base64, 32 bytes). Generate: openssl rand -base64 32
SCREENSHOT_ENCRYPTION_KEY=change-me-base64-32-byte-key
